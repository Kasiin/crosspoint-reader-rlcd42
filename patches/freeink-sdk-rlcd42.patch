diff --git a/libs/display/FreeInkDisplay/src/driver/St7305Driver.cpp b/libs/display/FreeInkDisplay/src/driver/St7305Driver.cpp
new file mode 100644
index 0000000..3d783e4
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/driver/St7305Driver.cpp
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Initialization and RAM mapping adapted from LinIT-L/ESP32-S3-RLCD-BBK
+// components/st7305/st7305.c, revision 1c0549206f128c311103f374ee46c38b95229c91.
+#include <BoardConfig.h>
+
+#if FREEINK_DRIVER_ST7305
+#include <cstring>
+#include <initializer_list>
+
+#include "St7305Driver.h"
+#include "St7305Packing.h"
+
+namespace freeink {
+namespace {
+void command(EpdBus& bus, uint8_t cmd, std::initializer_list<uint8_t> values = {}) {
+  auto txn = bus.beginTxn();
+  txn.cmd(cmd);
+  for (const auto value : values) txn.data(value);
+}
+
+class St7305Driver final : public PanelDriver {
+ public:
+  uint32_t spiHz() const override { return BoardConfig::ACTIVE.displaySpiHz; }
+  BusyPolarity busyPolarity() const override { return BusyPolarity::ActiveHigh; }
+  PanelGeometry geometry() const override { return {400, 300, 50, 15000}; }
+
+  void begin(EpdBus& bus) override {
+    // Match the existing board's validated reset and register sequence.
+    const auto rst = BoardConfig::ACTIVE.display.rst;
+    digitalWrite(rst, HIGH);
+    delay(50);
+    digitalWrite(rst, LOW);
+    delay(20);
+    digitalWrite(rst, HIGH);
+    delay(50);
+    command(bus, 0xD6, {0x17, 0x02});
+    command(bus, 0xD1, {0x01});
+    command(bus, 0xC0, {0x11, 0x04});
+    command(bus, 0xC1, {0x69, 0x69, 0x69, 0x69});
+    command(bus, 0xC2, {0x19, 0x19, 0x19, 0x19});
+    command(bus, 0xC4, {0x4B, 0x4B, 0x4B, 0x4B});
+    command(bus, 0xC5, {0x19, 0x19, 0x19, 0x19});
+    command(bus, 0xD8, {0x80, 0xE9});
+    command(bus, 0xB2, {0x02});
+    command(bus, 0xB3, {0xE5, 0xF6, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45});
+    command(bus, 0xB4, {0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45});
+    command(bus, 0x62, {0x32, 0x03, 0x1F});
+    command(bus, 0xB7, {0x13});
+    command(bus, 0xB0, {0x64});
+    command(bus, 0x11);
+    delay(200);
+    command(bus, 0xC9, {0x00});
+    command(bus, 0x36, {0x48});
+    command(bus, 0x3A, {0x11});
+    command(bus, 0xB9, {0x20});
+    command(bus, 0xB8, {0x29});
+    command(bus, 0x21);
+    command(bus, 0x2A, {0x12, 0x2A});
+    command(bus, 0x2B, {0x00, 0xC7});
+    command(bus, 0x35, {0x00});
+    command(bus, 0xD0, {0xFF});
+    command(bus, 0x38);
+    command(bus, 0x29);
+    // Unlike e-paper this panel shows RAM live; push one white frame so boot
+    // noise is not visible until the firmware's first paint. The address
+    // window was already set above.
+    {
+      auto txn = bus.beginTxn();
+      txn.cmd(0x2C);
+      uint8_t white[75];
+      memset(white, 0xFF, sizeof(white));
+      for (int pair = 0; pair < 200; ++pair) txn.writeBytes(white, sizeof(white));
+    }
+  }
+
+  void deepSleep(EpdBus& bus) override {
+    command(bus, 0x28);
+    command(bus, 0x10);
+    delay(120);
+  }
+
+  void display(EpdBus& bus, const uint8_t* fb, const uint8_t*, RefreshMode, bool) override {
+    if (!fb) return;
+    // Refresh mode and turnOff are EPD hints: the LCD must remain powered to display.
+    command(bus, 0x36, {0x48});
+    command(bus, 0x2A, {0x12, 0x2A});
+    command(bus, 0x2B, {0x00, 0xC7});
+    auto txn = bus.beginTxn();
+    txn.cmd(0x2C);
+    uint8_t column[75];
+    for (int pair = 0; pair < 200; ++pair) {
+      for (int group = 0; group < 75; ++group) column[group] = st7305PackedByte(fb, pair, group);
+      txn.writeBytes(column, sizeof(column));
+    }
+  }
+
+  // The panel is monochrome: when the reader's grayscale pass ends, the BW
+  // base frame is already on screen and the framebuffer holds an MSB gray
+  // plane whose polarity this panel would show as a black frame. Keep the
+  // base by not re-displaying anything.
+  void displayGray(EpdBus&, const uint8_t*, bool, const unsigned char*, bool) override {}
+};
+}  // namespace
+
+PanelDriver& st7305Driver() {
+  static St7305Driver driver;
+  return driver;
+}
+}  // namespace freeink
+#endif
