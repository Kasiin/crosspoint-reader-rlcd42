diff --git a/libs/display/FreeInkDisplay/src/driver/St7305Packing.h b/libs/display/FreeInkDisplay/src/driver/St7305Packing.h
new file mode 100644
index 0000000..5c56831
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/driver/St7305Packing.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <cstdint>
+
+namespace freeink {
+// ST7305 RAM stores two columns by four vertically reversed rows per byte.
+inline uint8_t st7305PackedByte(const uint8_t* frame, const int columnPair, const int rowGroup) {
+  uint8_t packed = 0;
+  for (int row = 0; row < 4; ++row) {
+    const int y = 299 - (rowGroup * 4 + row);
+    for (int col = 0; col < 2; ++col) {
+      const int x = columnPair * 2 + col;
+      const bool white = (frame[y * 50 + x / 8] & (0x80 >> (x % 8))) != 0;
+      if (white) packed |= uint8_t(1u << (7 - row * 2 - col));
+    }
+  }
+  return packed;
+}
+}  // namespace freeink
